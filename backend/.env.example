NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lost-and-found
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=30m
CLIENT_URL=http://localhost:5173
# Image storage: cloudinary (when the three values below are set) or local (disk fallback)
IMAGE_STORAGE=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Photo matching (lost-item search). Photo similarity is enabled when a token
# is set; without it the app falls back to text-only matching.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# Minimum cosine similarity (0-1) for a photo to count as a match
SIMILARITY_THRESHOLD=0.8
TEXT_MATCH_THRESHOLD=0.45
